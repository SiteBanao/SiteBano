# ---------------------------------------------------------------
# SiteBanao configuration
# Copy this file to `.env.local` (for local dev) and add the same
# variables in your hosting provider's dashboard for production.
# Leave a value empty to show a "coming soon" placeholder instead.
# All values are public (they are shown on the website).
# ---------------------------------------------------------------

# Public URL of the site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# WhatsApp number with country code, digits only (e.g. 91XXXXXXXXXX).
# Used by the floating button and every "WhatsApp" CTA with pre-filled messages.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact details shown in the footer and on the Contact page
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# Social profiles (full URLs). Empty = greyed-out "coming soon" icon.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# Enquiry form delivery (optional). Any endpoint that accepts a JSON POST
# and returns a 2xx status on success, for example:
#   Formspree:  https://formspree.io/f/<your-form-id>
#   Web3Forms:  https://api.web3forms.com/submit   (+ access key below)
# Leave empty to run the form in "demo mode": nothing is sent to a server, and
# visitors are offered WhatsApp / email / copy-to-clipboard instead.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
